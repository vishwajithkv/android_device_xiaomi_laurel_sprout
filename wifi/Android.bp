// Diagnostic launcher; parameters are selected before ath10k probes.
cc_binary {
    name: "laurel_wifi_start",
    vendor: true,
    srcs: ["laurel_wifi_start.cpp"],
    static_libs: ["libbase", "libmodprobe"],
    shared_libs: ["liblog"],
    cflags: ["-Wall", "-Werror"],
}
