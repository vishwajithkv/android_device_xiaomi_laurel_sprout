# SPDX-License-Identifier: Apache-2.0
type laurel_batteryd, domain;
type laurel_batteryd_exec, exec_type, vendor_file_type, file_type;
type laurel_qg_device, dev_type;
init_daemon_domain(laurel_batteryd)
allow laurel_batteryd laurel_qg_device:chr_file { open read write getattr ioctl };
allowxperm laurel_batteryd laurel_qg_device:chr_file ioctl { 0x5170 0x5171 };
userdebug_or_eng(`
    allow shell laurel_qg_device:chr_file { open read getattr ioctl };
    allowxperm shell laurel_qg_device:chr_file ioctl { 0x5170 };
')
recovery_only(`
    allow recovery laurel_qg_device:chr_file { open read write getattr ioctl };
    allowxperm recovery laurel_qg_device:chr_file ioctl { 0x5170 0x5171 };
')
